# Copia su contenido en Environment de Dokploy después de generar las claves.
# py preparar_despliegue.py crea .env con claves aleatorias sin mostrarlas.
DJANGO_SECRET_KEY=
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_PASSWORD=
DJANGO_ALLOW_INSECURE_ADMIN=false
DJANGO_ALLOWED_HOSTS=chatcognitivo.tech,www.chatcognitivo.tech,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://chatcognitivo.tech,https://www.chatcognitivo.tech
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_COOKIE_SECURE=true

# CPU por defecto. Para NVIDIA usa también docker-compose.gpu.yml y cambia a 16.
COMPOSE_PROFILES=ollama
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=deepseek-r1:8b
OLLAMA_NUM_GPU=0
OLLAMA_NUM_CTX=4096
OLLAMA_CHAT_MAX_TOKENS=512

# Ollama externo: deja COMPOSE_PROFILES vacío y configura una URL privada accesible.
# La URL 127.0.0.1 dentro de Docker apunta al propio contenedor, no a tu computadora.
